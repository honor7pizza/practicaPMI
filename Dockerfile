# Берем легкую официальную версию Python
FROM python:3.11-slim

# Настраиваем рабочую папку внутри контейнера
WORKDIR /app

# Копируем файлы нашего проекта внутрь контейнера
COPY app.py database.py ./

# Устанавливаем библиотеки напрямую, чтобы не возиться с venv внутри докера
RUN pip install Flask flask-cors

# Открываем порт 5000 наружу
EXPOSE 5000

# Команда для запуска сервера при старте контейнера
CMD ["python", "app.py"]
